from __future__ import annotations

from pathlib import Path
import re
from typing import List, Tuple

from snakemake.io import expand  # noqa: F401

configfile: "workflow/config.yaml"

# =============================================================================
# Paths
# =============================================================================

WORKDIR = Path(config["workdir"])
if not WORKDIR.exists():
    raise FileNotFoundError(f"'workdir' does not exist: {WORKDIR}")

workdir: str(WORKDIR)

PROJECT_ROOT = WORKDIR.parent
SCRIPT_DIR = PROJECT_ROOT / "scripts"

IN_DIR = Path(config["in_dir"])
OUT_DIR = Path(config["out_dir"])

EPOCH_DIR = Path(config.get("epoch_dir", OUT_DIR / "epochs"))
EPOCH_TASK = config.get("epoch_task", "conversation")

if not EPOCH_DIR.exists():
    raise FileNotFoundError(
        f"Epoch directory does not exist: {EPOCH_DIR}. "
        "Run preprocessing first or set 'epoch_dir' in config."
    )

# =============================================================================
# Design constants
# =============================================================================

CONVERSATION_RUNS: List[int] = list(range(1, 9))
BANDS: List[str] = ["alpha", "beta"]

contrast_cfg = config["erp"]["contrast"]
CONTRASTS: List[str] = ["duration", "latency"] if contrast_cfg == "both" else [contrast_cfg]

# =============================================================================
# Subjects / runs
# =============================================================================

def list_subjects() -> List[str]:
    exclude = set(config["subjects"]["exclude"])
    subjects: List[str] = []

    for sub_dir in IN_DIR.iterdir():
        if not sub_dir.is_dir():
            continue
        if not re.fullmatch(r"sub-\d+", sub_dir.name):
            continue
        if sub_dir.name in exclude:
            continue
        subjects.append(sub_dir.name)

    return sorted(subjects)

INVALID_SUBJECT_RUN: set[Tuple[str, int]] = {
    (str(x[0]), int(x[1])) for x in config.get("invalid_subject_run", [])
}

def valid_subject_runs(subjects: List[str], runs: List[int]) -> List[Tuple[str, int]]:
    out: List[Tuple[str, int]] = []
    for subject in subjects:
        for run in runs:
            if (subject, run) in INVALID_SUBJECT_RUN:
                continue
            out.append((subject, run))
    return out

SUBJECTS = list_subjects()
VALID_SR = valid_subject_runs(SUBJECTS, CONVERSATION_RUNS)

VALID_SUBJECTS = [s for s, _ in VALID_SR]
VALID_RUNS = [r for _, r in VALID_SR]

def epoch_inputs() -> List[str]:
    """
    Epoch files are assumed to already exist (generated by the Python preprocessing pipeline).
    """
    return expand(
        str(EPOCH_DIR / "{subject}_{task}_run-{run}_epo.fif"),
        subject=VALID_SUBJECTS,
        run=VALID_RUNS,
        task=[EPOCH_TASK],
    )

# =============================================================================
# Includes
# =============================================================================

include: "workflow/rules/analysis.smk"
include: "workflow/rules/stats.smk"
include: "workflow/rules/viz.smk"
include: "workflow/rules/targets.smk"
