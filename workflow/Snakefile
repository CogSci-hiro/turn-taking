# =============================================================================
#                             turn-taking Snakemake entry
# =============================================================================
#
# Design
# ------
# - Snakemake orchestrates dependencies.
# - All scientific work is delegated to the single Python dispatcher (cli/main.py).
# - We track completion with sentinel files under io.out_dir/<analysis>/_DONE.
# - Dataset discovery is done *only* from io.epoch_dir + io.epoch_pattern.
#
# Layout assumed
# --------------
# <project_root>/
#   workflow/
#     Snakefile
#     config.yaml
#     envs/python.yaml        (optional, if you run with --use-conda)
#     rules/
#       common.smk
#       analysis.smk
#       targets.smk
#   src/turntaking/cli/main.py
#

from pathlib import Path

# Always resolve config relative to the Snakefile (robust to CWD / PyCharm)
WORKFLOW_DIR = Path(workflow.basedir)
CONFIG_PATH = str(WORKFLOW_DIR / "config.yaml")
configfile: CONFIG_PATH
print(CONFIG_PATH)

# In Snakefile (global): enforce common wildcard formats
wildcard_constraints:
    subject="sub-\d{3}",
    task="[A-Za-z0-9_-]+",
    run="\d+"

include: str(WORKFLOW_DIR / "rules" / "bootstrap.smk")
include: str(WORKFLOW_DIR / "rules" / "common.smk")
include: str(WORKFLOW_DIR / "rules" / "analysis.smk")
include: str(WORKFLOW_DIR / "rules" / "stats.smk")
include: str(WORKFLOW_DIR / "rules" / "viz.smk")

rule all:
    input:
        ERP_OUT
        + TFR_OUT
        + DECODING_OUT
        + [T1_LMM]
        + FIG_MAIN
        + FIG_SUPP
